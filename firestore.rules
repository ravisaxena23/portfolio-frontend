rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // Public portfolio content (site reads this; seed only via Console / temporary unlock)
    match /portfolio/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Contact form — anyone can CREATE one message; nobody can read/update/delete from the client
    match /Message/{messageId} {
      allow create: if isValidContact()
                    && messageId.size() <= 40;
      allow read, update, delete: if false;
    }

    function isValidContact() {
      let data = request.resource.data;
      return data.keys().hasOnly(['name', 'email', 'mobileNumber', 'query', 'createdAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 80
        && data.email is string
        && data.email.size() > 3
        && data.email.size() <= 120
        && data.email.matches('.*@.*\\..*')
        && data.mobileNumber is string
        && data.mobileNumber.size() >= 7
        && data.mobileNumber.size() <= 20
        && data.query is string
        && data.query.size() > 0
        && data.query.size() <= 2000
        && data.createdAt is string
        && data.createdAt.size() <= 40;
    }
  }
}
